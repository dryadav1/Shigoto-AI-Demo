# SHIGOTO AI server config — copy to .env
PORT=4000
# Local/dev database (SQLite file). Leave unset to use ./server/data/shigoto.db
DB_DIR=./server/data
# Production database (Postgres, e.g. Neon). When set, SQLite is not used.
DATABASE_URL=
PG_SSL=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Set true when serving over HTTPS in production (secure refresh cookie)
COOKIE_SECURE=false
# Production: skip demo seed data (default: seed demo users + enquiries)
SEED_DEMO=true
# With SEED_DEMO=false, bootstrap the first owner account from these:
ADMIN_NAME=Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=
